classDiagram
    %% PawPal+ draft UML (Phase 1). Keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +complete_task(title: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str time
        +str frequency
        +date due_date
        +str pet_name
        +bool completed
        +mark_complete() None
        +priority_rank() int
        +next_occurrence() Task
    }

    class Scheduler {
        +Owner owner
        +list~Task~ skipped
        +generate_plan() list~Task~
        +sort_by_priority(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
        +detect_conflicts(tasks: list~Task~) list~str~
        +explain_plan(plan: list~Task~) str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : plans for
